{
  "name": "www-helia-identify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Run identify with a peer with Helia in a browser",
  "license": "ISC",
  "scripts": {
    "clean": "rimraf ./dist",
    "copy-assets": "mkdir -p dist && cp src/index.html src/style.css dist",
    "build": "npm run copy-assets && node esbuild.js",
    "start": "npm run copy-assets && node esbuild.js --serve",
    "test": "npm run build && test-browser-example test"
  },
  "browserslist": "last 1 Chrome version",
  "dependencies": {
    "@helia/libp2p": "^1.0.8",
    "@ipshipyard/libp2p-inspector-metrics": "^2.0.0",
    "@libp2p/identify": "^4.1.12",
    "@libp2p/peer-id": "^6.0.14",
    "@libp2p/webtransport": "^6.0.34",
    "@multiformats/multiaddr": "^13.0.3",
    "helia": "^7.1.2",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
